+  letter-spacing: 1.5px;
+  text-transform: uppercase;
+  white-space: nowrap;
+  text-shadow:
+    0 0 8px rgba(255, 255, 255, 0.7),
+    0 3px 10px rgba(0, 0, 0, 0.9);
+}
+
+@keyframes venomBannerIn {
+  from {
+    opacity: 0;
+    transform: translateX(-50%) translateY(-6px);
+  }
+  to {
+    opacity: 1;
+    transform: translateX(-50%) translateY(0);
+  }
+}
+
+/* Pantallas chicas: un toque más grande y más arriba, para que no
+   quede tapado por fichas apiladas ni por el panel de opciones de
+   destino (ver MoveOptionsPanel). */
+@media (max-width: 480px) {
+  .venom-banner {
+    top: 6%;
+    padding: 10px 20px;
+  }
+  .venom-banner-icon {
+    width: 40px;
+    height: 40px;
+  }
+  .venom-banner-emoji {
+    font-size: 36px;
+  }
+  .venom-banner-label {
+    font-size: 26px;
+  }
+}
